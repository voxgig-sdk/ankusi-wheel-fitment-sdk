# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 2
  metrics: count: path: 4
  metrics: count: method: 4

  entity: dataset: {
    path: "/dataset/csv": {
      action: "csv": {}
      op: load: method: *GET
    }
    path: "/dataset/json": {
      action: "json": {}
      op: list: method: *GET
    }
  }

  entity: fitment: {
    path: "/fitment": {
      op: list: method: *GET
      op: list: transform: res: *("`body.results`")|top
    }
    path: "/makes": {
      op: list: method: *GET
      op: list: transform: res: *("`body.results`")|top
    }
  }

}