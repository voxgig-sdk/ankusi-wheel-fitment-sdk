      "info": {
        "auth": false,
        "contact": {
          "name": "ANKUSI Wheels",
          "url": "https://ankusiwheels.com/wheel-fitment-api/"
        },
        "description": "Free wheel fitment data (bolt pattern, center bore, factory wheel size and offset, reference flush and maximum aftermarket sizes) for about 10,000 vehicles, served by a WordPress REST namespace on ankusiwheels.com. No key, CORS enabled, data licensed CC BY 4.0 (credit \"ANKUSI Wheel Fitment Dataset\"). Endpoints from the documentation page https://ankusiwheels.com/wheel-fitment-api/ and the WordPress namespace index (GET /wp-json/ankusi/v1); every schema was taken from live GET probes on 2026-10-23 (dataset version 2026.10.19, 10093 records). The docs ask for no more than one request per second; responses are cached for an hour. Divergences from the docs: lug_count is a string in most records but an integer in some newer ones (403 of 10093 in the full dataset, e.g. AITO M8), and the limit parameter is silently capped at 100. Site-internal routes in the namespace (embed-ping, blog-*, pins, inquiry, ev, inline-swap) are not part of the public API and are not modelled. Unverified: whether make matching tolerates whitespace or aliases, and the exact semantics of year when combined with bolt_pattern only.",
        "license": {
          "name": "CC BY 4.0 (data)",
          "url": "https://creativecommons.org/licenses/by/4.0/"
        },
        "meta_source": "https://www.freepublicapis.com",
        "servers": [
          {
            "description": "ANKUSI WordPress REST namespace",
            "url": "https://ankusiwheels.com/wp-json/ankusi/v1"
          }
        ],
        "summary": "Free wheel fitment data (bolt pattern, center bore, factory wheel size and offset, reference flush and maximum aftermarket sizes) for about 10,000 vehicles, served by a WordPress REST namespace on ankusiwheels.com.",
        "title": "ANKUSI Wheel Fitment API",
        "version": "1.0.0",
        "website": "https://ankusiwheels.com"
      },
